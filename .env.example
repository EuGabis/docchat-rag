# Copie para .env e preencha o que for usar.

# Opcional: sem chave, o app funciona em "modo somente recuperação" (mostra os trechos encontrados).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Opcional: com Docker (docker compose up -d). Vazio = PostgreSQL + pgvector embutido em ./.pgdata
# DATABASE_URL=postgresql://docchat:docchat@localhost:5433/docchat

# Ajustes da busca
TOP_K=6
CHUNK_SIZE=900
CHUNK_OVERLAP=150
